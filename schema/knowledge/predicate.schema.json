{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curricula.live/schema/knowledge/predicate.schema.json",
  "title": "curricula.live predicate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "label"],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}
