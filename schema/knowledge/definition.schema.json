{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curricula.live/schema/knowledge/definition.schema.json",
  "title": "curricula.live canonical definition v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["concept_id", "statement_ids"],
  "properties": {
    "concept_id": {
      "type": "string",
      "format": "uuid"
    },
    "statement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
